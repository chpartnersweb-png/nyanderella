---
import { Image } from 'astro:assets';
import cat from '../assets/cats/cat017.jpg';
import SectionLabel from './SectionLabel.astro';
import Arrow from './Arrow.astro';
import { supportMethods, site } from '../data/site';
---
<section class="support section-space" id="support" aria-labelledby="support-title">
  <div class="container support-layout">
    <div class="support-intro" data-reveal><SectionLabel number="05" text="迎える以外の関わり方" light /><h2 id="support-title">できることから、<br>猫たちの力に。</h2><figure class="support-photo"><Image src={cat} alt="前足をそろえて穏やかに過ごす茶白の猫" width={600} format="webp" loading="lazy" /></figure></div>
    <div class="support-options"><p class="support-intro-line"><span>あなたに合った、</span><span>応援のかたち。</span></p>{supportMethods.map((method,i) => <details class="support-option" data-disclosure data-reveal><summary><span class="support-option__number">0{i+1}</span><span><small>{method.english}</small>{method.title}</span><span class="disclosure-icon" aria-hidden="true"></span></summary><div class="disclosure-content"><p>{method.text}</p><a class="text-link" href={site.phoneHref}>支援について電話で相談する<Arrow /></a></div></details>)}<p class="support-business">支援者・協賛企業の皆さまからのご相談もお待ちしています。</p></div>
  </div>
</section>
