---
import '../styles/global.css';
import '../styles/storybook.css';
import { site } from '../data/site';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Cats from '../components/Cats.astro';
import About from '../components/About.astro';
import Room from '../components/Room.astro';
import Adoption from '../components/Adoption.astro';
import Support from '../components/Support.astro';
import Faq from '../components/Faq.astro';
import Visit from '../components/Visit.astro';
import Footer from '../components/Footer.astro';
import Arrow from '../components/Arrow.astro';
import Loading from '../components/Loading.astro';
import Seo from '../components/Seo.astro';
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('is-loading');
        root.dataset.pageLoadingAt = String(performance.now());
        const release = () => {
          root.classList.remove('is-loading');
          delete root.dataset.pageLoadingAt;
          document.querySelector('[data-page-loader]')?.remove();
        };
        // Release the page even if the main bundle or an image fails to load.
        window.setTimeout(release, 4200);
        window.addEventListener('pageshow', event => { if (event.persisted) release(); });
      })();
    </script>
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/fonts/zen-maru-gothic.css" />
    <link rel="preload" href="/fonts/zen-maru-gothic-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/zen-maru-gothic-400.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo />
    <meta name="theme-color" content="#fff8e9" />
    <meta name="generator" content={Astro.generator} />
  </head>

  <body id="top">
    <Loading />
    <a class="skip-link" href="#main">本文へスキップ</a>
    <Header />
    <main id="main">
      <Hero />
      <aside class="notice"><div class="container notice-inner"><span class="notice-label"><span class="reservation-dot"></span> ご来訪について</span><p>にゃんデレラは完全予約制です。<br class="mobile-only" />開催日程は最新のお知らせをご確認ください。</p><a class="button button--primary button--guide" href={site.blogUrl} target="_blank" rel="noopener noreferrer">最新のお知らせ<Arrow /></a></div></aside>
      <Cats /><About /><Room /><Adoption /><Support /><Faq /><Visit />
    </main>
    <Footer />
    <script>
      import '../scripts/main';
    </script>
  </body>


</html>
